# 服务器端口
PORT=3000

# MongoDB连接地址
MONGODB_URI=mongodb://localhost:27017/superapp

# JWT密钥（必须至少32位，生产环境请使用随机生成的强密钥）
# 生成方式: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_at_least_32_chars_long

# 上传文件目录
UPLOAD_DIR=./uploads

# 注册邀请码（必须配置，否则无法注册新用户）
REGISTER_INVITE_CODE=your_invite_code_here

# 运行环境（生产环境设为production，将隐藏错误细节）
NODE_ENV=development

# API基础地址（用于客户端配置）
API_BASE_URL=http://localhost:3000
